# Copy to secrets.env, fill in, then: sops -e secrets.env > secrets.env.enc
# On the box: sops -d secrets.env.enc > /etc/fd/secrets.env && chmod 600 /etc/fd/secrets.env
# Every value here is new — nothing from the old Pro box's compose file is reused.
POSTGRES_PASSWORD=
FLASK_SECRET_KEY=
FLASK_ADMIN_EMAIL=patrick@alaskafamilysystems.com
FLASK_MAIL_SERVER=smtp-relay.brevo.com
FLASK_MAIL_PORT=587
FLASK_MAIL_USERNAME=
FLASK_MAIL_PASSWORD=
FLASK_MAIL_DEFAULT_SENDER=info@alaskafamilysystems.com
FLASK_SITE_URL=https://familydiagram.com
FLASK_RP_ORIGIN=https://familydiagram.com
# The landing page's captcha (R-0601): the two keys of a Turnstile widget created
# in the Cloudflare dashboard for familydiagram.com. Without them its forms stay shut.
FLASK_TURNSTILE_SITE_KEY=
FLASK_TURNSTILE_SECRET_KEY=
# Which service answers the coach's Claude calls: anthropic, with the key below,
# on the box; bedrock only on a machine signed in to Amazon Bedrock.
BTCOPILOT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
# Gemini groups events into clusters on the picture and writes session titles,
# on this Developer API key; a Bedrock machine runs those on Claude instead.
GOOGLE_GEMINI_API_KEY=
# A coach model on OpenAI (alias gpt), for shadows and replays.
OPENAI_API_KEY=
GRAFANA_PG_PASSWORD=
# A read-only token for the concept pages in patrickkidd/btcopilot-sources (FD-364).
FLASK_THEORY_GITHUB_TOKEN=
# Web push to the coach's notifications; python -m btcopilot.push makes a pair.
# A new pair breaks every browser's subscription, so it is made once and kept.
FLASK_VAPID_PUBLIC_KEY=
FLASK_VAPID_PRIVATE_KEY=
# Who the push services write to about this server's pushes, as mailto:<address>.
FLASK_VAPID_SUBJECT=mailto:info@alaskafamilysystems.com
