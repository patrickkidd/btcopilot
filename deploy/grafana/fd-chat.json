      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ffz1wy7unkdfke"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with msgs as (\n  select d.user_id, count(*) as messages\n  from statements s join discussions d on d.id=s.discussion_id\n  join speakers sp on sp.id=s.speaker_id\n  where not exists (select 1 from diagrams dg where dg.id=d.diagram_id and dg.scratch) and sp.type='Subject' and $__timeFilter(s.created_at)\n  group by d.user_id\n),\nreplies as (\n  select d.user_id, count(*) as replies\n  from statements s join discussions d on d.id=s.discussion_id\n  join speakers sp on sp.id=s.speaker_id\n  where not exists (select 1 from diagrams dg where dg.id=d.diagram_id and dg.scratch) and sp.type='Expert' and $__timeFilter(s.created_at)\n  group by d.user_id\n),\ncalls as (\n  select mc.user_id, count(*) as calls, sum(mc.input_tokens) as tokens_in,\n         sum(mc.output_tokens) as tokens_out, sum(mc.cache_read_tokens) as tokens_cache_read,\n         sum(mc.cost_usd) as cost\n  from model_calls mc\n  where not exists (select 1 from diagrams dg where dg.id=mc.diagram_id and dg.scratch) and mc.purpose <> 'shadow' and $__timeFilter(mc.created_at)\n  group by mc.user_id\n)\nselect u.username as email,\n  coalesce(msgs.messages,0) as messages,\n  coalesce(replies.replies,0) as coach_replies,\n  coalesce(calls.calls,0) as calls,\n  coalesce(calls.tokens_in,0) as tokens_in,\n  coalesce(calls.tokens_out,0) as tokens_out,\n  coalesce(calls.tokens_cache_read,0) as tokens_cache_read,\n  coalesce(calls.cost,0) as cost\nfrom users u\nleft join msgs on msgs.user_id=u.id\nleft join replies on replies.user_id=u.id\nleft join calls on calls.user_id=u.id\nwhere (coalesce(msgs.messages,0) > 0 or coalesce(replies.replies,0) > 0 or coalesce(calls.calls,0) > 0)\n  and u.id in ($user) and u.username not like 'claude-test%'\norder by cost desc, messages desc",
          "refId": "A"
        }
      ],
      "title": "This month by person",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
