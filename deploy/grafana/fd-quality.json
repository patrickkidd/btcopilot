          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(mc.created_at,'1d'), mc.model as metric, sum(mc.cost_usd)/count(distinct mc.turn_id) as value from model_calls mc join users u on u.id=mc.user_id where u.username not like 'claude-test%' and $__timeFilter(mc.created_at) group by 1, mc.model order by 1",
          "refId": "A"
        }
