          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(mc.created_at,'1d'), mc.model || ' model calls' as metric, count(*)::float/count(distinct mc.turn_id) as value from model_calls mc join users u on u.id=mc.user_id where u.username not like 'claude-test%' and $__timeFilter(mc.created_at) group by 1, mc.model order by 1",
