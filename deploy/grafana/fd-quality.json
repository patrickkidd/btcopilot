            "uid": "ffz1wy7unkdfke"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with t as (select mc.turn_id, min(mc.created_at) as at from model_calls mc join users u on u.id=mc.user_id where u.username not like 'claude-test%' and $__timeFilter(mc.created_at) group by mc.turn_id) select $__timeGroupAlias(t.at,'1d'), k.kind as metric, count(o.id)::float/count(distinct t.turn_id) as value from t cross join (select unnest(enum_range(null::observationkind))::text as kind) k left join observations o on o.turn_id = t.turn_id and o.kind::text = k.kind group by 1, k.kind order by 1",
          "refId": "A"
        }
      ],
      "id": 4
