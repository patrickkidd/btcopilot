    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "fd-vl"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 7,
      "options": {
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "fd-vl"
          },
          "editorMode": "code",
          "expr": "CONTAINER_NAME:~\".+\" _msg:~\"(?i)error|traceback|exception\"",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Errors and exceptions (last 6h)",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "fd-vl"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
