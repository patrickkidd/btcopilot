            "type": "victoriametrics-logs-datasource",
            "uid": "fd-vl"
          },
          "editorMode": "code",
          "expr": "CONTAINER_NAME:~\".+\" | extract_regexp \"^(?:familydiagram-|chat-)?(?P<service>.+?)(?:-[0-9]+)?$\" from CONTAINER_NAME | stats by (service) count() lines",
          "queryType": "statsRange",
          "refId": "A",
