          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fd-vm"
          },
          "expr": "sum by (service) (label_replace(container_memory_usage_total_bytes, \"service\", \"$1\", \"container_name\", \"^(?:familydiagram-|chat-)?(.+?)(?:-[0-9]+)?$\"))",
          "instant": false,
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Memory used by container",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fd-vm"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
