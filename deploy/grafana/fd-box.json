          "datasource": {
            "type": "prometheus",
            "uid": "fd-vm"
          },
          "expr": "sum by (service) (label_replace(rate(container_cpu_usage_nanoseconds_total[5m]), \"service\", \"$1\", \"container_name\", \"^(?:familydiagram-|chat-)?(.+?)(?:-[0-9]+)?$\")) / 1e9",
