          "format": "table",
          "rawQuery": true,
          "rawSql": "with t as (select u.username || ' / ' || dg.id as family, d.id as sitting_id, te.created_at, (te.payload->'coverage'->'after'->>'known')::float as known, (te.payload->'coverage'->'after'->>'required')::float as required, row_number() over (partition by dg.id order by te.created_at, te.id) as turn, row_number() over (partition by d.id order by te.created_at, te.id) as sitting_turn, dense_rank() over (partition by dg.id order by d.id) as sitting from turn_events te join discussions d on d.id = te.discussion_id join diagrams dg on dg.id = d.diagram_id join users u on u.id = dg.user_id where te.kind = 'done' and te.payload->'coverage' is not null and not dg.scratch and not d.synthetic and u.username not like 'claude-test%' and u.username in (${people:sqlstring}) and u.username !~ '${exclude}') select t.family as \"family\", t.turn as \"coach turn\", round((100 * t.known / nullif(t.required, 0))::numeric, 1) as \"coverage %\" from t where $__timeFilter(t.created_at) order by 1, 2",
