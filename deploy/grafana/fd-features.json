          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with first_session as (select pe.user_id, pe.session_id, min(pe.client_at) as session_start, row_number() over (partition by pe.user_id order by min(pe.client_at)) as rn from product_events pe group by pe.user_id, pe.session_id), fs as (select user_id, session_id from first_session where rn = 1) select u.username as person, string_agg(pe.screen, ' -> ' order by pe.client_at) filter (where pe.name = 'screen_open') as path, extract(epoch from (max(pe.client_at) - min(pe.client_at)))/60.0 as session_minutes from product_events pe join fs on fs.user_id = pe.user_id and fs.session_id = pe.session_id join users u on u.id = pe.user_id where u.username in (${people:sqlstring}) and u.username !~ '${exclude}' group by u.username order by u.username",
          "refId": "A"
        }
      ],
      "title": "First session path",
      "type": "table"
