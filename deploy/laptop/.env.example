# Copy to deploy/laptop/.env (git-ignored) and fill in.
FD_BOX=fdlink@<box address>
GF_SECURITY_ADMIN_PASSWORD=
# The password of the box's read-only Postgres role grafana (GRAFANA_PG_PASSWORD in /etc/fd/secrets.env on the box).
GRAFANA_PG_PASSWORD=
# interim until the box has the fdlink user; then link (README, "After the deploy").
COMPOSE_PROFILES=interim
