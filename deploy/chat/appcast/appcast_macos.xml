        <item>
            <title>2.1.10</title>
            <description>&lt;ul&gt;
  &lt;li&gt;Added autosave&lt;/li&gt;
  &lt;li&gt;Immediate auto-save when a document is opened&lt;/li&gt;
  &lt;li&gt;Periodic auto-save every 30 minutes while document is open&lt;/li&gt;
  &lt;li&gt;Timestamped filenames (YYYYMMDD_HHMMSS format) compatible with tiered retention&lt;/li&gt;
  &lt;li&gt;Auto-save stops when document is closed or for read-only documents&lt;/li&gt;
  &lt;li&gt;Added changelog to auto updates&lt;/li&gt;
&lt;/ul&gt;</description>
            <pubDate>Sat, 22 Nov 2025 07:54:28 +0000</pubDate>
            <enclosure sparkle:version="2.1.10" sparkle:shortVersionString="2.1.10" url="https://github.com/patrickkidd/familydiagram/releases/download/2.1.10/Family.Diagram.dmg" length="32084587" type="application/octet-stream"/>
