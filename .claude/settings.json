{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git stash:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git -C:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin master)",
      "Bash(git push -u origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git checkout master)",
      "Bash(git switch master)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/bin/git-guard", "timeout": 5 }
        ]
      }
    ]
  }
}
