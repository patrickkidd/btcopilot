#!/usr/bin/env python3
"""Run one component's tests, or the ones the current diff touches.

    bin/t chat|review|personal|admin|prompts|web|walks|pro|training|all
    bin/t              the suites the working diff touches

Prints what it chose and why. Exits non-zero if any suite fails.
"""

import os
import subprocess
import sys
from enum import Enum
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
WEB = REPO / "web"
# On a developer's Mac the venv is the uv workspace above the repo; on a runner
# the package is installed into the interpreter running this script.
WORKSPACE = next((p for p in REPO.parents if (p / ".venv").is_dir()), None)
PYTEST = (
    ["uv", "run", "--project", str(WORKSPACE), "python", "-m", "pytest", "-q"]
    if WORKSPACE
    else [sys.executable, "-m", "pytest", "-q"]
)


class Suite(Enum):
    Chat = "chat"
    Review = "review"
    Personal = "personal"
    Admin = "admin"
    Prompts = "prompts"
    Web = "web"
    Walks = "walks"
    Pro = "pro"
    Training = "training"


COMMANDS = {
    Suite.Chat: PYTEST + ["btcopilot/tests/chat"],
    Suite.Review: PYTEST + ["btcopilot/tests/chat/review"],
    Suite.Personal: PYTEST + ["btcopilot/tests/chat/personal"],
    Suite.Admin: PYTEST + ["btcopilot/tests/chat/test_admin.py"],
    Suite.Prompts: PYTEST + ["btcopilot/tests/chat/personal/test_promptfiles.py"],
    Suite.Pro: PYTEST + ["btcopilot/tests/pro"],
    Suite.Training: PYTEST + ["btcopilot/tests/training"],
    Suite.Web: ["npm", "run", "test"],
    Suite.Walks: ["npm", "run", "test:visual"],
}

CWD = {Suite.Web: WEB, Suite.Walks: WEB}

ALL = (Suite.Chat, Suite.Pro, Suite.Training, Suite.Web)

# A changed path picks its suites. First match wins, longest prefix first.
ROUTES = (
    ("btcopilot/tests/chat/review", (Suite.Review,)),
    ("btcopilot/tests/chat/personal", (Suite.Personal,)),
    ("btcopilot/tests/chat", (Suite.Chat,)),
    ("btcopilot/tests/pro", (Suite.Pro,)),
    ("btcopilot/tests/training", (Suite.Training,)),
    ("btcopilot/tests/fixtures.py", (Suite.Chat, Suite.Pro, Suite.Training)),
    ("btcopilot/review", (Suite.Review,)),
    ("btcopilot/personal/promptdir", (Suite.Prompts,)),
    ("btcopilot/personal", (Suite.Personal,)),
    ("btcopilot/admin", (Suite.Admin,)),
    ("btcopilot/pro", (Suite.Pro,)),
    ("btcopilot/training", (Suite.Training,)),
    ("private/prompts", (Suite.Prompts,)),
    ("web/tests/visual", (Suite.Walks,)),
    ("web/test", (Suite.Web,)),
    ("web/src", (Suite.Web, Suite.Walks)),
    ("alembic", (Suite.Review,)),
)


def changed() -> list[str]:
    """Every path the working tree has touched against the branch point."""
    base = subprocess.run(
        ["git", "-C", str(REPO), "merge-base", "HEAD", "master"],
        capture_output=True,
        text=True,
    ).stdout.strip()
    args = ["git", "-C", str(REPO), "diff", "--name-only"]
    paths = subprocess.run(args, capture_output=True, text=True).stdout.split()
    paths += subprocess.run(
        args + ["--cached"], capture_output=True, text=True
    ).stdout.split()
    if base:
        paths += subprocess.run(
            args + [base], capture_output=True, text=True
        ).stdout.split()
    return sorted(set(paths))


def route(paths: list[str]) -> dict[Suite, str]:
    """The suites the paths call for, each with the path that called for it."""
    chosen: dict[Suite, str] = {}
    for path in paths:
        for prefix, suites in ROUTES:
            if path.startswith(prefix):
                for suite in suites:
                    chosen.setdefault(suite, path)
                break
    return chosen


def run(suite: Suite) -> int:
    print(f"\n--- {suite.value} ---", flush=True)
    env = dict(os.environ, PYTHONPATH=str(REPO))
    return subprocess.run(
        COMMANDS[suite], cwd=CWD.get(suite, REPO), env=env
    ).returncode


def main(argv: list[str]) -> int:
    if argv and argv[0] == "all":
        chosen = {suite: "asked for everything" for suite in ALL}
    elif argv:
        try:
            chosen = {Suite(name): "named on the command line" for name in argv}
        except ValueError:
            names = ", ".join(suite.value for suite in Suite)
            print(f"no such component. One of: {names}, all", file=sys.stderr)
            return 2
    else:
        chosen = route(changed())
        if not chosen:
            print("nothing changed that any suite covers.")
            return 0

    for suite, why in chosen.items():
        print(f"{suite.value}: {why}")

    failed = [suite.value for suite in chosen if run(suite) != 0]
    if failed:
        print(f"\nfailed: {', '.join(failed)}")
        return 1
    print(f"\npassed: {', '.join(suite.value for suite in chosen)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
