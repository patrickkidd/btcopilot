#!/usr/bin/env python3
"""The builder's pre-commit hook, installed in this worktree only.

  uv run bin/builder-hook install --files 'btcopilot/x.py,btcopilot/tests/test_x.py'
  uv run bin/builder-hook install              # the coordinator: any file
  uv run bin/builder-hook install --base origin/FD-366 --files ...

Refuses a commit with a second migration the base (origin/master unless
--base) does not have, a staged file outside the declared set, a stash entry
made since the install, or a conflict marker.
"""
import argparse
import fnmatch
import subprocess
import sys
import time
from pathlib import Path

VERSIONS = "btcopilot/migrations/versions/"
MARKERS = (b"<<<<<<< ", b">>>>>>> ")


def git(*args: str) -> str:
    return blob(*args).decode()


def blob(*args: str) -> bytes:
    return subprocess.run(["git", *args], check=True, stdout=subprocess.PIPE).stdout


def gitdir() -> Path:
    return Path(git("rev-parse", "--absolute-git-dir").strip())


def setting(key: str, default: str) -> str:
    found = subprocess.run(
        ["git", "config", "--get", key], stdout=subprocess.PIPE, text=True
    ).stdout.strip()
    return found or default


def install(files: str | None, base: str | None):
    hooks = gitdir() / "hooks"
    hooks.mkdir(exist_ok=True)
    hook = hooks / "pre-commit"
    hook.write_text(f'#!/bin/sh\nexec "{sys.executable}" "{Path(__file__).resolve()}" check\n')
    hook.chmod(0o755)
    declared = gitdir() / "builder-files"
    if files:
        declared.write_text("\n".join(g.strip() for g in files.split(",") if g.strip()) + "\n")
    else:
        declared.unlink(missing_ok=True)
    git("config", "extensions.worktreeConfig", "true")
    git("config", "--worktree", "core.hooksPath", str(hooks))
    git("config", "--worktree", "builder.base", base or "origin/master")
    git("config", "--worktree", "builder.installed", str(int(time.time())))


def migrations() -> list[str]:
    root = Path(git("rev-parse", "--show-toplevel").strip())
    ours = {p.relative_to(root).as_posix() for p in (root / VERSIONS).glob("*.py")}
    base = setting("builder.base", "origin/master")
    theirs = set(git("ls-tree", "-r", "--name-only", base, VERSIONS).split())
    return sorted(ours - theirs)


def staged() -> list[str]:
    return git("diff", "--cached", "--name-only", "--diff-filter=ACMR").split("\n")[:-1]


def refusals() -> list[str]:
    found = []
    new = migrations()
    if len(new) > 1:
        found.append(
            f"one migration per PR: this branch has {len(new)} migration files "
            f"{setting('builder.base', 'origin/master')} does not "
            f"({', '.join(Path(p).name for p in new)}); squash them into one"
        )
    declared = gitdir() / "builder-files"
    if declared.exists():
        globs = declared.read_text().split()
        outside = [p for p in staged() if not any(fnmatch.fnmatch(p, g) for g in globs)]
        if outside:
            found.append(
                f"declared files only: {', '.join(outside)} is outside this builder's files "
                f"({', '.join(globs)}); unstage it or ask the coordinator"
            )
    installed = int(setting("builder.installed", "0"))
    if any(int(t) >= installed for t in git("stash", "list", "--format=%ct").split()):
        found.append(
            "never git stash: a stash entry was made since the hook was installed; "
            "restore it and drop it"
        )
    marked = [
        p for p in staged()
        if any(line.startswith(MARKERS) for line in blob("show", f":{p}").splitlines())
    ]
    if marked:
        found.append(f"no conflict markers: {', '.join(marked)} still holds one")
    return found


def check() -> int:
    found = refusals()
    for line in found:
        print(f"builder-hook: commit refused, {line}", file=sys.stderr)
    return int(bool(found))


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd", required=True)
    installer = sub.add_parser("install")
    installer.add_argument("--files")
    installer.add_argument("--base")
    sub.add_parser("check")
    args = parser.parse_args()
    if args.cmd == "install":
        install(args.files, args.base)
        return 0
    return check()


if __name__ == "__main__":
    sys.exit(main())
