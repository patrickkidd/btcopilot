#!/usr/bin/env python3
"""The builder's pre-commit hook, installed in this worktree only.

  uv run bin/builder-hook install --name picks --files 'btcopilot/x.py,btcopilot/tests/test_x.py'
  uv run bin/builder-hook install --name picks  # drops that builder's set
  uv run bin/builder-hook install --base origin/FD-366 --files ...

Each builder's set is kept apart; with no set at all, any file goes. Refuses a
commit with a second migration the base (origin/master unless --base) does
not have, staged files no one builder's set holds all of, a stash entry made
since the install, or a conflict marker.
"""
import argparse
import fnmatch
import subprocess
import sys
import time
from pathlib import Path

VERSIONS = "btcopilot/migrations/versions/"
MARKERS = (b"<<<<<<< ", b">>>>>>> ")
BASE = "origin/master"


def git(*args: str) -> str:
    return blob(*args).decode()


def blob(*args: str) -> bytes:
    return subprocess.run(["git", *args], check=True, stdout=subprocess.PIPE).stdout


def gitdir() -> Path:
    return Path(git("rev-parse", "--absolute-git-dir").strip())


def setting(key: str, default: str) -> str:
    found = subprocess.run(
        ["git", "config", "--get", key], stdout=subprocess.PIPE, text=True
    ).stdout.strip()
    return found or default


def install(name: str, files: str | None, base: str | None):
    hooks = gitdir() / "hooks"
    hooks.mkdir(exist_ok=True)
    hook = hooks / "pre-commit"
    hook.write_text(f'#!/bin/sh\nexec "{sys.executable}" "{Path(__file__).resolve()}" check\n')
    hook.chmod(0o755)
    git("config", "extensions.worktreeConfig", "true")
    key = f"builder.files.{name}"
    if files:
        globs = ",".join(g.strip() for g in files.split(",") if g.strip())
        git("config", "--worktree", key, globs)
    else:
        subprocess.run(["git", "config", "--worktree", "--unset", key])
    git("config", "--worktree", "core.hooksPath", str(hooks))
    git("config", "--worktree", "builder.base", base or BASE)
    git("config", "--worktree", "builder.installed", str(int(time.time())))


def migrations() -> list[str]:
    root = Path(git("rev-parse", "--show-toplevel").strip())
    ours = {p.relative_to(root).as_posix() for p in (root / VERSIONS).glob("*.py")}
    base = setting("builder.base", BASE)
    theirs = set(git("ls-tree", "-r", "--name-only", base, VERSIONS).split())
    return sorted(ours - theirs)


def declared() -> dict[str, list[str]]:
    lines = subprocess.run(
        ["git", "config", "--get-regexp", r"^builder\.files\."],
        stdout=subprocess.PIPE,
        text=True,
    ).stdout.splitlines()
    return {
        key.removeprefix("builder.files."): globs.split(",")
        for key, globs in (line.split(" ", 1) for line in lines)
    }


def staged() -> list[str]:
    return git("diff", "--cached", "--name-only", "--diff-filter=ACMR").split("\n")[:-1]


def refusals() -> list[str]:
    found = []
    new = migrations()
    if len(new) > 1:
        found.append(
            f"one migration per PR: this branch has {len(new)} migration files "
            f"{setting('builder.base', BASE)} does not "
            f"({', '.join(Path(p).name for p in new)}); squash them into one"
        )
    sets = declared()
    files = staged()
    covered = any(
        all(any(fnmatch.fnmatch(p, g) for g in globs) for p in files)
        for globs in sets.values()
    )
    if sets and not covered:
        found.append(
            f"declared files only: {', '.join(files)} is outside any one builder's files "
            f"({', '.join(sorted(sets))}); unstage the rest or ask the coordinator"
        )
    installed = int(setting("builder.installed", "0"))
    if any(int(t) >= installed for t in git("stash", "list", "--format=%ct").split()):
        found.append(
            "never git stash: a stash entry was made since the hook was installed; "
            "restore it and drop it"
        )
    marked = [
        p for p in staged()
        if any(line.startswith(MARKERS) for line in blob("show", f":{p}").splitlines())
    ]
    if marked:
        found.append(f"no conflict markers: {', '.join(marked)} still holds one")
    return found


def check() -> int:
    found = refusals()
    for line in found:
        print(f"builder-hook: commit refused, {line}", file=sys.stderr)
    return int(bool(found))


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="cmd", required=True)
    installer = sub.add_parser("install")
    installer.add_argument("--name", default="builder")
    installer.add_argument("--files")
    installer.add_argument("--base")
    sub.add_parser("check")
    args = parser.parse_args()
    if args.cmd == "install":
        install(args.name, args.files, args.base)
        return 0
    return check()


if __name__ == "__main__":
    sys.exit(main())
